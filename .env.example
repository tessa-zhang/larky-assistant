# ── LiteLLM ──────────────────────────────────────────────────────────────────
# Used for message classification, via Traveloka's IT-listed LiteLLM proxy.
# classify.js now hits LiteLLM's OpenAI-compatible endpoint
# (POST /v1/chat/completions) rather than the Anthropic-passthrough — so the
# proxied model can be ANY provider on your key's allow-list (Claude, GPT,
# Gemini, DeepSeek, …), not just Claude. The var names stay ANTHROPIC_* for
# backwards compat with existing .env files; they're historical labels now,
# not a provider lock-in.
# ANTHROPIC_API_KEY is your LiteLLM VIRTUAL key — sent as a Bearer token.
# ANTHROPIC_BASE_URL is where every triaged message's text is sent, so it must
# be the proxy target IT/Security has approved for company data.
ANTHROPIC_API_KEY=your_litellm_virtual_key_here
ANTHROPIC_BASE_URL=https://litellm.tvlk.cloud

# ── Behaviour ────────────────────────────────────────────────────────────────
# Who sends the digest card. Default: bot (the R2 hosted surface).
#   bot  → the bot DMs you the card. Enables the `digest` keyword trigger +
#          text-command Done/Snooze. Requires the one-time app setup (bot +
#          im.message.receive_v1 event + scopes; see README "Enabling the bot").
#   user → DEPRECATED self-chat delivery via YOUR identity. Kept only as a manual
#          CLI fallback; needs the im:message.send_as_user scope (not in the
#          least-privilege set), so leave this on `bot` unless you know you need it.
SEND_AS=bot

# Model used for classification. Must be on your LiteLLM virtual key's
# allow-list (which uses LiteLLM's own naming, not the upstream provider's).
# Run `npm run probe-models` to list the ids your key can actually hit, then
# paste one here. Historical name: CLAUDE_MODEL — kept for backwards compat,
# but it accepts any OpenAI-compatible model LiteLLM proxies (gpt-5,
# gemini-2.5-pro, deepseek-v3, …).
CLAUDE_MODEL=claude-sonnet-5

# Fixed lookback window, in HOURS. EVERY run scans this far back for CURRENTLY-
# unread mentions/DMs — independent of when you last ran the digest (running it
# doesn't mark anything read). Items leave the digest by replying, `done`, or
# `snooze`. Default 168h (7 days) — a week matches how most people keep their
# inbox clear; raise/lower to taste (the ideal range is somewhat role-dependent).
# NOTE: do NOT also set LOOKBACK_DAYS — if present it's multiplied by 24 and,
# when LOOKBACK_HOURS is unset, wins. Use one or the other; prefer LOOKBACK_HOURS.
LOOKBACK_HOURS=168

# How far back to look for YOUR OWN messages when building the reply watermark
# (so a reply just before the window still counts as "read"). Default 14 days.
WATERMARK_LOOKBACK_DAYS=14

# How long Snooze hides an item, in hours.
SNOOZE_HOURS=24

# Optional: override your own open_id (else auto-detected from auth status).
# LARK_USER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate-limit guard: warn/cap if a run would fetch more than this many messages.
MAX_MESSAGES=200
