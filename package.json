{
  "name": "lark-triage-bot",
  "version": "1.0.0",
  "description": "On-demand Lark triage assistant: scans your @mentions and DMs, classifies them with Claude, and delivers a prioritised interactive-card digest.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "inlark": "node src/index.js digest",
    "morning": "node src/index.js morning",
    "done": "node src/index.js done",
    "snooze": "node src/index.js snooze",
    "listen": "node src/index.js listen",
    "adduser": "node src/index.js adduser",
    "listusers": "node src/index.js listusers",
    "reset-key": "node src/index.js reset-key",
    "probe-models": "node src/probeModels.js",
    "service:install": "node scripts/launchd.js install",
    "service:status": "node scripts/launchd.js status",
    "service:logs": "node scripts/launchd.js logs",
    "service:uninstall": "node scripts/launchd.js uninstall",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
